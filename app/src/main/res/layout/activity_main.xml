<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🏋️ Fit Tracker"
              android:textColor="@color/text_primary"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_marginBottom="2dp"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Tréningy a aktivity"
              android:textColor="@color/text_muted"
              android:textSize="11sp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_theme"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="8dp"
            android:textSize="16sp"
            android:backgroundTint="@color/bg_button_neutral"/>

        <Button
            android:id="@+id/btn_profile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="👤"
            android:textSize="16sp"
            android:backgroundTint="@color/bg_button_neutral"/>

      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="16dp"/>

      <!-- Motivačný odkaz o počte tréningov v zobrazenom mesiaci -->
      <TextView
          android:id="@+id/tv_month_motivation"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_card_rounded"
          android:padding="12dp"
          android:gravity="center"
          android:text=""
          android:textColor="@color/accent_primary_soft"
          android:textSize="14sp"
          android:textStyle="bold"
          android:layout_marginBottom="14dp"/>

      <!-- Month navigation -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btn_prev_month"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg_button_neutral"/>

        <TextView
            android:id="@+id/tv_month_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Máj 2026"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_next_month"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="›"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg_button_neutral"/>

      </LinearLayout>

      <!-- Calendar grid container - populated programmatically -->
      <LinearLayout
          android:id="@+id/calendar_container"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginBottom="14dp"/>

      <!-- Legend - populated programmatically -->
      <LinearLayout
          android:id="@+id/legend_container"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@drawable/bg_card_rounded"
          android:padding="12dp"/>

    </LinearLayout>
  </ScrollView>

  <!-- Mimo ScrollView — tlačidlá zostávajú pripnuté k spodku obrazovky, nie za krátkym obsahom -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="16dp"
      android:paddingTop="10dp">

    <Button
        android:id="@+id/btn_stats"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginRight="6dp"
        android:text="▦  Štatistiky"
        android:textColor="@color/accent_primary_dark"
        android:textSize="12sp"
        android:background="@drawable/bg_button_primary"/>

    <Button
        android:id="@+id/btn_progress"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginRight="6dp"
        android:text="🏋️  Progres"
        android:textColor="@color/accent_primary_text"
        android:textSize="12sp"
        android:backgroundTint="@color/accent_secondary"/>

    <Button
        android:id="@+id/btn_catalog"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="📖  Katalóg"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:backgroundTint="@color/bg_button_neutral"/>

  </LinearLayout>

</LinearLayout>
