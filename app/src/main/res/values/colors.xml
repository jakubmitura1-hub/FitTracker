<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Svetlá editoriálna paleta (Classical): papierový podklad, zlatá ako obrys.
         Názvy sú zámerne nezmenené — appka sa skompiluje bez úprav Javy. -->

    <!-- Pozadia -->
    <color name="bg_app">#F3F2F2</color>
    <color name="bg_card">#F8F4F4</color>
    <color name="bg_card_alt">#EAE9E9</color>
    <color name="bg_hint">#FFF3E4</color>
    <color name="bg_chip">#EAE7E7</color>
    <color name="bg_input">#F8F4F4</color>
    <color name="bg_button_neutral">#EAE7E7</color>

    <!-- Text -->
    <color name="text_primary">#201F1D</color>
    <color name="text_secondary">#605D5D</color>
    <color name="text_muted">#7D7979</color>
    <color name="text_white">#FFFFFF</color>
    <color name="text_on_accent">#3A270D</color>

    <!-- Hlavný akcent (zlatá) -->
    <color name="accent_primary">#B68235</color>
    <color name="accent_primary_dark">#7D5411</color>
    <color name="accent_primary_soft">#FFE3BF</color>
    <color name="accent_primary_text">#5A3B0A</color>

    <!-- Sekundárny akcent (tlačidlo Progres) — na svetlom podklade je to tichá plocha -->
    <color name="accent_secondary">#EAE7E7</color>

    <!-- Zvýraznenie (osobné rekordy) -->
    <color name="accent_highlight">#A06F24</color>

    <!-- Nebezpečenstvo / zmazanie — stmavené, aby prešlo 4.5:1 na papieri -->
    <color name="accent_danger">#9C3B34</color>
    <color name="accent_danger_dark">#6E2A25</color>
    <color name="accent_danger_darker">#4A1C18</color>

    <!-- Kalendár -->
    <color name="today_bg">#FFF3E4</color>
    <color name="today_stroke">#B68235</color>
    <color name="day_cell_bg">#F8F4F4</color>

    <!-- Ostatné -->
    <color name="separator">#D7D3D3</color>
    <color name="input_border">#BAB6B6</color>

    <!-- Diagramy svalových partií — ponechané bez zmeny, drawables sa netreba prekresľovať. -->
    <color name="muscle_neutral">#4A4438</color>
    <color name="muscle_highlight">#E0503F</color>

    <!-- Veľká anatomická mapa (MuscleMapView) — pomocný sval (hlavný = muscle_highlight). -->
    <color name="muscle_secondary">#4F86E0</color>
</resources>
