<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FitTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <!-- Svetlý podklad ⇒ tmavé ikony v status bare, inak zmiznú -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="android:fontFamily">@font/lora</item>
    </style>

    <!-- Nadpisy: Cormorant Garamond, nikdy bold -->
    <style name="FitTracker.Heading" parent="">
        <item name="android:fontFamily">@font/cormorant_garamond</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Kicker / label nad sekciou -->
    <style name="FitTracker.Kicker" parent="">
        <item name="android:fontFamily">@font/lora</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
